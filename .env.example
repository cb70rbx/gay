# Discord Bot Configuration
# Replace these placeholder values with your actual credentials

# Required: Your Discord bot token from the Discord Developer Portal
TOKEN=your_discord_bot_token_here

# Optional: Your Discord application client ID and secret
CLIENT_ID=your_discord_client_id_here
CLIENT_SECRET=your_discord_client_secret_here

# Bot command prefix (default is "?")
DEFAULT_PREFIX=?

# Optional: NASA API key for the space command
# NASA_API_KEY=your_nasa_api_key_here